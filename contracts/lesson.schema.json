{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-lesson/lesson-meta.schema.json",
  "title": "Github metadata",
  "description": "Schema สำหรับตรวจ metadata หลัง registration; ไม่ใช่ schema ของ HTML ทั้งไฟล์",
  "type": "object",
  "required": ["id", "version", "meta"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$" },
    "meta": {
      "type": "object",
      "required": ["worldType", "lessonId", "title", "category", "subcategory", "description", "keyResult", "defaultValue", "editSchema", "howto", "quiz"],
      "properties": {
        "worldType": { "const": "3d-world-space" },
        "scenePersistence": { "enum": ["reset", "lesson"] },
        "lessonId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "keyResult": { "type": "string" },
        "background": { "type": "string" },
        "camera": {
          "type": "object",
          "properties": {
            "fov": { "type": "number" },
            "startYaw": { "type": "number" },
            "startPitch": { "type": "number" },
            "startDistance": { "type": "number" },
            "minDistance": { "type": "number" },
            "maxDistance": { "type": "number" },
            "minPitch": { "type": "number" },
            "maxPitch": { "type": "number" },
            "target": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "additionalProperties": false
        },
        "welcomeMessage": { "type": "array", "items": { "type": "string" } },
        "tooltip": { "type": "string" },
        "defaultValue": { "type": "object" },
        "editSchema": { "type": "array", "items": { "type": "object" } },
        "howto": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "title", "type", "desc"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "title": { "type": "string" },
              "type": { "enum": ["sequence", "freestyle"] },
              "desc": { "type": "string" },
              "intro": {
                "type": "object",
                "properties": {
                  "url": { "type": "string", "minLength": 1 },
                  "src": { "type": "string", "minLength": 1 },
                  "title": { "type": "string" },
                  "label": { "type": "string" }
                },
                "anyOf": [{ "required": ["url"] }, { "required": ["src"] }],
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        },
        "quiz": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

