{
  "sdkVersion": "3.4.0",
  "worldOwner": "main-world",
  "accessProfiles": {
    "teacherExternal": {
      "output": "one-lesson-html",
      "allowedObjects": ["primitive", "group", "text3d", "library", "zone", "callout", "world-counter", "world-gui", "guideline", "line-render", "target-focus"],
      "forbidden": ["custom-asset", "model", "runtime-edit", "shared-asset-edit", "network"]
    },
    "devWorkspace": {
      "defaultScope": "lesson-only",
      "explicitlyAuthorizedExtensions": ["custom-asset", "model", "runtime", "public-api", "catalog"]
    }
  },
  "lessonOwns": ["scene-composition", "interaction-state", "answer-condition", "lab-step-behavior", "quiz-data"],
  "scenePersistence": {
    "default": "reset",
    "optIn": "meta.scenePersistence=lesson",
    "lessonResponsibilities": ["reuse-static-objects", "clear-dynamic-objects-on-reset", "dispose-all-on-close"]
  },
  "objects": ["primitive", "group", "text3d", "library", "zone", "callout", "world-counter", "world-gui", "guideline", "line-render", "target-focus"],
  "primitiveShapes": [
    "box", "rounded-box", "sharp-box", "sphere", "hemisphere",
    "cylinder", "half-cylinder", "quarter-cylinder", "cone", "pyramid", "prism", "frustum", "capsule",
    "sector", "sector-flat", "ring-sector", "ring-sector-flat", "tube",
    "torus", "torus-knot", "circle", "plane", "arrow-flat", "ring", "star", "heart", "cross", "wedge",
    "tetrahedron", "octahedron", "dodecahedron", "icosahedron", "diamond",
    "polygon", "polygon-flat", "polyhedron", "lathe", "spline-tube",
    "cube", "cuboid", "rectangle", "rectangle-flat", "triangle", "semicircle", "semi-cylinder", "quarter-circle",
    "pie", "pie-slice", "annular-sector", "arc", "disc", "donut", "extrude-polygon", "custom-polyhedron", "path-tube"
  ],
  "interactions": ["drag", "click", "custom-hit-area", "actionable-callout", "actionable-world-gui"],
  "guiServices": {
    "steps": "context.ui.steps",
    "question": "context.ui.question",
    "guiAnswer": "context.ui.guiAnswer",
    "console": "context.ui.console",
    "topMessage": "context.ui.topMessage",
    "choice": "context.ui.choice",
    "gizmo": "context.ui.gizmo",
    "worldOption": "context.ui.worldOption",
    "worldGuiSystem": "context.ui.worldGuiSystem",
    "clickme": "context.ui.clickme",
    "intro": "context.ui.intro",
    "feedback": "context.ui.feedback",
    "dialog": "context.ui.dialog",
    "insight": "context.ui.insight",
    "control": "context.ui.control",
    "hint": "context.ui.hint",
    "busy": "context.ui.busy"
  },
  "systemUi": {
    "topbar": "mainWorldSetting.ui.topbar",
    "modeBadge": "mainWorldSetting.ui.modeBadge",
    "quizBadge": "mainWorldSetting.ui.quizBadge",
    "popup": "mainWorldSetting.ui.popup",
    "cameraControls": "mainWorldSetting.ui.cameraControls",
    "worldHint": "mainWorldSetting.ui.worldHint",
    "worldCallout": "mainWorldSetting.ui.worldCallout",
    "worldCounter": "mainWorldSetting.ui.worldCounter",
    "worldGui": "mainWorldSetting.ui.worldGui",
    "worldGuiSystem": "mainWorldSetting.ui.worldGuiSystem",
    "worldOption": "mainWorldSetting.ui.worldOption",
    "debugAreaTransformEditor": "system-owned via Runtime Setting F6",
    "loadingEntry": "mainWorldSetting.entry",
    "mascotCharacter": "mainWorldSetting.mascot",
    "celebrationVfx": "mainWorldSetting.vfx.celebrationEffect"
  },
  "deprecatedUi": {
    "hud": "context.ui.feedback",
    "toast": "context.ui.console"
  },
  "guiScopes": ["lesson", "scene", "step", "question", "manual"],
  "guiAuthoringPolicy": "existing-central-service-first-no-lesson-owned-duplicate-ui",
  "controlPhasePolicy": "teaching=system-skip-only; lab-final-or-experiment=lesson-controls; quiz=lesson-controls; back-to-teaching=hides-lesson-controls",
  "guidedStepGate": "howto.requiresCompletion=true; unlock with context.ui.steps.setNextEnabled(true)",
  "mascotStepDialogue": "howto.option={type:instruction|hint|feedback,header,message}",
  "lineRenderPaths": ["from-to", "points", "closed"],
  "cameraFocus": "world.camera.focus({position,normal}) preserves zoom and eases transition",
  "runtimeUiTheme": "storybook-brown-cream-on-felt-environment",
  "devTools": {
    "quickRetest": "F4",
    "runtimeSetting": "F6",
    "runtimeModeSwitch": ["teacher-lab", "student-quiz"],
    "runtimeRefresh": "same-as-F4",
    "guiServiceLab": ["preview", "update", "clear"],
    "debugArea": ["grid-x-z", "model-position", "model-rotation-degrees", "model-scale", "live-transform-editor", "copy-transform"]
  },
  "backgrounds": ["green"],
  "assetCatalogVersion": "1.2.4",
  "libraryModelMaterialOptions": ["color", "opacity", "textureEnabled", "depthWrite", "roughness", "metalness", "textureLight"],
  "standardAssetCount": 214,
  "centralGridSettings": ["ground.gridColor", "ground.gridOpacity", "ground.ringColor"],
  "worldCalloutPurpose": "point-to-world-area-and-optionally-open-insight",
  "worldCounterPurpose": "display-numeric-count-on-world-surface",
  "worldGuiPurpose": "display-explanatory-text-on-world-surface; optionally actionable through insight/onClick",
  "gizmoPurpose": "screen-space-object-or-position-overlay",
  "worldOptionPurpose": "vertical action popup anchored to a clicked 3D object and emitting lesson-defined events",
  "standardAssets": [
    "food/apple",
    "food/pizza",
    "food/pizza-slice",
    "sports/ball",
    "science/water-tank",
    "math/balance-scale",
    "space/rocket",
    "classroom/counter",
    "environment/wooden-plate",
    "environment/picnic-blanket"
  ],
  "operatorPrefab": ["<", ">", "=", "≠", "<=", ">=", "≤", "≥", "+", "-", "−", "×", "x", "X", "÷"],
  "operatorPrefabSetting": "mainWorldSetting.lessonGraphics.operatorBase.heightScale",
  "questionUi": "context.ui.question.show",
  "compatibilityUi": ["context.ui.setQuestion", "context.ui.clearQuestion", "context.ui.setObjective", "context.ui.toast", "context.ui.setProgress"],
  "optionalFutureCapabilities": ["throw", "physics", "balance", "pour-state"]
}

